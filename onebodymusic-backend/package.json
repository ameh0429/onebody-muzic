{
  "name": "onebodymusic-backend",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage --runInBand",
    "test:db": "tsx --test test/database.integration.ts",
    "db:migrate": "tsx src/database/migrate.ts up",
    "db:status": "tsx src/database/migrate.ts status",
    "db:rollback": "tsx src/database/migrate.ts down",
    "db:seed": "tsx src/database/seed.ts",
    "db:migrate:prod": "node dist/database/migrate.js up",
    "db:seed:prod": "node dist/database/seed.js",
    "test:auth:db": "npm run build && tsx --test test/auth.database.integration.ts",
    "test:users:db": "npm run build && tsx --test test/users.database.integration.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.8",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.8",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.2.8",
    "@nestjs/sequelize": "11.0.1",
    "@nestjs/swagger": "^11.4.8",
    "argon2": "0.45.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "18.0.9",
    "helmet": "^8.3.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "8.23.1",
    "pg-hstore": "2.3.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sequelize": "6.37.8",
    "sequelize-typescript": "2.1.6",
    "swagger-ui-express": "^5.0.1",
    "umzug": "3.8.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.8",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "jest": "^30.5.2",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "tsx": "4.23.15",
    "typescript": "~5.9"
  }
}
