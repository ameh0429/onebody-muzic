NODE_ENV=development
PORT=3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Replace placeholders with your local PostgreSQL credentials. URL-encode special characters.
DATABASE_URL=postgresql://onebodymusic:CHANGE_ME@localhost:5432/onebodymusic
# Used only by the explicit seed command. Never commit real credentials.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# For the optional local Docker Compose database; match the password in DATABASE_URL.
POSTGRES_PASSWORD=

# Dedicated database for integration tests. Never use production.
TEST_DATABASE_URL=

# Generate a strong random signing secret (at least 32 characters). No default secret.
JWT_SECRET=
# 60–3600 seconds; default 15 minutes.
JWT_ACCESS_TOKEN_TTL_SECONDS=900

# Enable only after supplying real server-side Cloudinary credentials.
MEDIA_ENABLED=false
# Leave unset while media is disabled; fill when enabling.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
MEDIA_AUDIO_MAX_BYTES=26214400
MEDIA_IMAGE_MAX_BYTES=5242880
MEDIA_MAX_CONCURRENT_UPLOADS=2
MEDIA_CLEANUP_INTERVAL_SECONDS=60
MEDIA_STALE_UPLOAD_SECONDS=900

# Song-scoped playback tickets; never use a permanent CDN URL as the browser source.
MEDIA_PLAYBACK_TTL_SECONDS=60
MEDIA_PLAYBACK_IDLE_TIMEOUT_SECONDS=30
