NODE_ENV=development
PORT=3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Replace placeholders with your local PostgreSQL credentials. URL-encode special characters.
DATABASE_URL=postgresql://onebodymusic:CHANGE_ME@localhost:5432/onebodymusic
# Used only by the explicit seed command. Never commit real credentials.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# For the optional local Docker Compose database; match the password in DATABASE_URL.
POSTGRES_PASSWORD=

# Dedicated database for integration tests. Never use production.
TEST_DATABASE_URL=
