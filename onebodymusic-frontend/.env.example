# Public frontend configuration only. Never put secrets here.
# Development uses Vite's /api proxy to localhost:3000.
VITE_API_BASE_URL=/api/v1
# Production example: https://api.your-church.org/api/v1
# Match the backend's configured limits. Backend validation remains authoritative.
VITE_AUDIO_MAX_BYTES=26214400
VITE_IMAGE_MAX_BYTES=5242880
# At least 30 s above the backend MEDIA_UPLOAD_TIMEOUT_SECONDS (default 90 s).
VITE_MEDIA_UPLOAD_TIMEOUT_SECONDS=120
